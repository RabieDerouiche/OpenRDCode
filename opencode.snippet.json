{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": { "temperature": 0.2 },
    "plan": { "temperature": 0.1 }
  },
  "permission": {
    "skill": { "*": "allow" },
    "bash": {
      "env": "deny",
      "env *": "deny",
      "printenv*": "deny",
      "set": "deny",
      "*zshenv*": "deny",
      "*zshrc*": "deny",
      "git push*": "ask",
      "git reset*": "ask",
      "git rebase*": "ask",
      "rm -rf*": "ask"
    }
  }
}
